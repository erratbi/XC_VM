# ─── XC_VM Local Development Environment Configuration ───

# HTTP Port for XC_VM Admin Panel & Streaming (default: 8880 -> http://localhost:8880)
XCVM_HTTP_PORT=8880

# HTTPS Port for XC_VM (default: 8443 -> https://localhost:8443)
XCVM_HTTPS_PORT=8443

# Admin Panel Route Code (default: admin -> http://localhost:8880/admin)
XCVM_ADMIN_CODE=admin

# Default Admin Credentials (auto-seeded if fresh database)
XCVM_ADMIN_USER=admin
XCVM_ADMIN_PASS=admin1234
XCVM_ADMIN_EMAIL=admin@example.com

# MariaDB Host Port (for external GUI tools: TablePlus, DBeaver, Sequel Ace)
MYSQL_PORT=3306

# phpMyAdmin Web UI Port (default: 8080 -> http://localhost:8080)
PMA_PORT=8080

# Redis Host Port
REDIS_PORT=6379
